{
  "name": "@packet-schema/core",
  "version": "0.1.0",
  "description": "PSDL core — types, expression evaluator, normalize, layout, constraint solver, and YAML I/O",
  "license": "MIT",
  "author": "Taquan Aoki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Packet-Schema/core.git"
  },
  "homepage": "https://github.com/Packet-Schema/core#readme",
  "bugs": {
    "url": "https://github.com/Packet-Schema/core/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
